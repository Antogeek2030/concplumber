---
const phone = '+19255550199';
const phoneDisplay = '(925) 555-0199';
const currentPath = Astro.url.pathname;
---
<header class="header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-icon">🔧</span>
      <span class="logo-text">Concord Pro Plumbers<br /><small>Water Heater Experts</small></span>
    </a>

    <nav class="nav" id="nav">
      <a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a>

      <div class="dropdown">
        <button class="dropdown-toggle" aria-expanded="false">Our Services <span class="caret">▾</span></button>
        <div class="dropdown-menu">
          <a href="/services/emergency-water-heater-repair/">Emergency Water Heater Repair</a>
          <a href="/services/tank-water-heater-repair/">Tank Water Heater Repair</a>
          <a href="/services/tankless-water-heater-repair/">Tankless Water Heater Repair</a>
          <a href="/services/leak-detection-repair/">Leak Detection &amp; Repair</a>
          <a href="/services/water-heater-maintenance/">Flush &amp; Maintenance</a>
          <a href="/services/water-heater-installation/">Water Heater Installation</a>
        </div>
      </div>

      <div class="dropdown">
        <button class="dropdown-toggle" aria-expanded="false">Problems <span class="caret">▾</span></button>
        <div class="dropdown-menu">
          <a href="/problems/no-hot-water/">No Hot Water</a>
          <a href="/problems/leaking-water-heater/">Leaking Water Heater</a>
          <a href="/problems/strange-noises/">Strange Noises</a>
          <a href="/problems/inconsistent-temperature/">Inconsistent Temperature</a>
          <a href="/problems/rusty-water/">Rusty or Discolored Water</a>
          <a href="/problems/pilot-light-issues/">Pilot Light Issues</a>
        </div>
      </div>

      <a href="/blog/">Blog</a>
      <a href="/service-areas/">Service Areas</a>
      <a href="/about/">About Us</a>
      <a href="/contact/">Contact</a>
    </nav>

    <a href={`tel:${phone}`} class="header-phone">
      <span>📞</span>
      <span class="phone-text">{phoneDisplay}</span>
    </a>
    <button class="mobile-toggle" id="menuBtn" aria-label="Menu">☰</button>
  </div>
</header>

<script>
  // Mobile menu
  const btn = document.getElementById('menuBtn');
  const nav = document.getElementById('nav');
  btn?.addEventListener('click', () => nav?.classList.toggle('open'));

  // Dropdowns (click on mobile, hover on desktop handled by CSS)
  document.querySelectorAll('.dropdown-toggle').forEach(toggle => {
    toggle.addEventListener('click', (e) => {
      e.preventDefault();
      const parent = toggle.closest('.dropdown');
      const isOpen = parent?.classList.contains('open');
      document.querySelectorAll('.dropdown').forEach(d => d.classList.remove('open'));
      if (!isOpen) parent?.classList.add('open');
    });
  });

  // Close dropdowns when clicking outside
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.dropdown')) {
      document.querySelectorAll('.dropdown').forEach(d => d.classList.remove('open'));
    }
  });
</script>
