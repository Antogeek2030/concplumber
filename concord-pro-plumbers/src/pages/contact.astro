---
import Layout from '../layouts/Layout.astro';
const phone = '+19255550199';
const phoneDisplay = '(925) 555-0199';
---
<Layout title="Contact | Concord Pro Plumbers" description="Contact Concord Pro Plumbers for same-day service. Call (925) 555-0199. Located at 2644 Richard Ave, Concord, CA 94520.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> → Contact</div>
      <h1>Contact Us</h1>
      <p>Ready for same-day water heater service in Concord? Call or reach out below.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="two-col">
        <div class="content-block" style="margin:0">
          <h2>Get in Touch</h2>
          <p><strong>Phone (24/7):</strong> <a href={`tel:${phone}`} style="color:var(--primary)">{phoneDisplay}</a></p>
          <p><strong>Address:</strong><br />2644 Richard Ave<br />Concord, CA 94520</p>
          <p><strong>Hours:</strong> Emergency service available 24 hours a day, 7 days a week. Standard scheduling during regular business hours.</p>
          <p style="margin-top:1.5rem"><a href={`tel:${phone}`} class="btn btn-primary">Call Now</a></p>
        </div>
        <div>
          <div class="map-wrapper" style="height:320px">
            <iframe title="Map" src="https://www.openstreetmap.org/export/embed.html?bbox=-122.0565496%2C37.9663318%2C-122.0365496%2C37.9863318&amp;layer=mapnik&amp;marker=37.9763318%2C-122.0465496" loading="lazy" style="width:100%;height:100%;border:0"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
