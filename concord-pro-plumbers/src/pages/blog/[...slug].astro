---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---
<Layout
  title={`${post.data.title} | Concord Pro Plumbers`}
  description={post.data.description}
>
  <section class="page-hero">
    <div class="container">
      <h1>{post.data.title}</h1>
      <p>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        · {post.data.author}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:720px;">
      <article class="blog-post prose">
        <Content />
      </article>
      <div style="margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--border);">
        <a href="/blog/" class="btn btn-outline-dark">← Back to Blog</a>
        <a href="tel:+19255550199" class="btn btn-primary" style="margin-left:0.75rem;">Call for Service</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-post :global(h2) {
    font-size: 1.45rem;
    margin: 2rem 0 0.75rem;
    color: var(--primary);
  }
  .blog-post :global(h3) {
    font-size: 1.2rem;
    margin: 1.5rem 0 0.5rem;
  }
  .blog-post :global(p) {
    margin-bottom: 1rem;
  }
  .blog-post :global(ul), .blog-post :global(ol) {
    margin: 0 0 1rem 1.25rem;
    list-style: disc;
  }
  .blog-post :global(li) {
    margin-bottom: 0.35rem;
  }
  .blog-post :global(a) {
    color: var(--primary);
    text-decoration: underline;
  }
</style>
